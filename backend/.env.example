# Vidyut Backend Environment Configuration Template
PORT=8000
NODE_ENV="development"

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vidyut_db?schema=public"

# JWT Authentication & Security
JWT_SECRET="vidyut_jwt_super_secret_signing_key_2026"
JWT_SECRET_KEY="vidyut_sih_2026_super_secret_jwt_key"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Administrative API Key (Guards pipeline ingestion and alias management)
ADMIN_KEY="vidyut_admin_secret_key"

# Optional External AI API Key (Gemini) - deterministic fallback active if omitted
GEMINI_API_KEY=""

# Optional Redis Cache URL
REDIS_URL="redis://localhost:6379/0"
