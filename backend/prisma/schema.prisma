// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------
// 1. Users & Core Profiles
// ----------------------------------------------------

enum UserRole {
  STUDENT
  INSTITUTION
  INDUSTRY
  ADMIN
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  studentProfile StudentProfile?
  institution    Institution?
  company        Company?

  @@map("users")
}

model StudentProfile {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String?   @unique @map("user_id") @db.Uuid
  fullName       String    @map("full_name") @db.VarChar(255)
  institution    String    @db.VarChar(255)
  degree         String    @db.VarChar(255)
  yearOfStudy    Int       @map("year_of_study")
  interests      String[]  @default([])
  selectedRoleId String?   @map("selected_role_id") @db.Uuid
  readinessPct   Float?    @default(0.0) @map("readiness_pct")
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user               User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  selectedRole       Role?                @relation(fields: [selectedRoleId], references: [id], onDelete: SetNull)
  assessmentSessions AssessmentSession[]
  skillStates        StudentSkillState[]
  roadmapStates      RoadmapState[]

  @@map("student_profiles")
}

model Institution {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?   @unique @map("user_id") @db.Uuid
  collegeName String    @map("college_name") @db.VarChar(255)
  aisheCode   String?   @map("aishe_code") @db.VarChar(100)
  officerName String    @map("officer_name") @db.VarChar(255)
  departments String[]  @default([])
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("institutions")
}

model Company {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?   @unique @map("user_id") @db.Uuid
  companyName String    @map("company_name") @db.VarChar(255)
  sector      String    @db.VarChar(100)
  website     String?   @db.VarChar(255)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("companies")
}

// ----------------------------------------------------
// 2. Career Domains, Roles & Skills
// ----------------------------------------------------

model Domain {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(255)
  description String?  @db.Text
  demandLevel String   @default("MEDIUM") @map("demand_level") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles Role[]

  @@map("domains")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  domainId    String   @map("domain_id") @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  domain             Domain              @relation(fields: [domainId], references: [id], onDelete: Cascade)
  skills             Skill[]
  studentProfiles    StudentProfile[]
  technologyBranches TechnologyBranch[]
  assessmentSessions AssessmentSession[]
  roadmapStates      RoadmapState[]

  @@unique([domainId, name])
  @@map("roles")
}

model Skill {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  category    String?  @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role             Role                     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  prerequisitesFor SkillPrerequisite[]      @relation("PrerequisiteSource")
  prerequisitesOf  SkillPrerequisite[]      @relation("PrerequisiteTarget")
  branchOptions    TechnologyBranchOption[]
  questions        Question[]
  skillStates      StudentSkillState[]
  milestones       Milestone[]

  @@unique([roleId, name])
  @@map("skills")
}

model SkillPrerequisite {
  skillId             String   @map("skill_id") @db.Uuid
  prerequisiteSkillId String   @map("prerequisite_skill_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  skill             Skill @relation("PrerequisiteSource", fields: [skillId], references: [id], onDelete: Cascade)
  prerequisiteSkill Skill @relation("PrerequisiteTarget", fields: [prerequisiteSkillId], references: [id], onDelete: Cascade)

  @@id([skillId, prerequisiteSkillId])
  @@map("skill_prerequisites")
}

model TechnologyBranch {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role          Role                     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  options       TechnologyBranchOption[]
  roadmapStates RoadmapState[]

  @@unique([roleId, name])
  @@map("technology_branches")
}

model TechnologyBranchOption {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  skillId   String   @map("skill_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  branch TechnologyBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  skill  Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([branchId, skillId])
  @@map("technology_branch_options")
}

// ----------------------------------------------------
// 3. Questions & Assessment Engine
// ----------------------------------------------------

model Question {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skillId       String   @map("skill_id") @db.Uuid
  questionText  String   @map("question_text") @db.Text
  optionA       String   @map("option_a") @db.Text
  optionB       String   @map("option_b") @db.Text
  optionC       String   @map("option_c") @db.Text
  optionD       String   @map("option_d") @db.Text
  correctOption String   @map("correct_option") @db.Char(1)
  difficulty    String   @default("MEDIUM") @db.VarChar(20)
  explanation   String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  skill     Skill              @relation(fields: [skillId], references: [id], onDelete: Cascade)
  responses QuestionResponse[]

  @@map("questions")
}

model AssessmentSession {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId   String?   @map("student_id") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  status      String    @default("STARTED") @db.VarChar(30)
  score       Float?    @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  student   StudentProfile?    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  role      Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)
  responses QuestionResponse[]

  @@map("assessment_sessions")
}

model QuestionResponse {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId      String   @map("session_id") @db.Uuid
  questionId     String   @map("question_id") @db.Uuid
  selectedOption String?  @map("selected_option") @db.Char(1)
  isCorrect      Boolean? @map("is_correct")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session  AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@map("question_responses")
}

model StudentSkillState {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId     String   @map("student_id") @db.Uuid
  skillId       String   @map("skill_id") @db.Uuid
  selfRating    String?  @map("self_rating") @db.VarChar(30)
  assessedLevel String?  @map("assessed_level") @db.VarChar(30)
  accuracy      Float?   @default(0)
  targetLevel   String?  @default("PROFICIENT") @map("target_level") @db.VarChar(30)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill   Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([studentId, skillId])
  @@map("student_skill_states")
}

// ----------------------------------------------------
// 4. Adaptive Roadmap & Milestones
// ----------------------------------------------------

model RoadmapState {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId        String   @map("student_id") @db.Uuid
  roleId           String   @map("role_id") @db.Uuid
  selectedBranchId String?  @map("selected_branch_id") @db.Uuid
  readinessPct     Float?   @default(0) @map("readiness_pct")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  student        StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  role           Role              @relation(fields: [roleId], references: [id], onDelete: Cascade)
  selectedBranch TechnologyBranch? @relation(fields: [selectedBranchId], references: [id], onDelete: SetNull)
  milestones     Milestone[]

  @@unique([studentId, roleId])
  @@map("roadmap_states")
}

model Milestone {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roadmapId      String   @map("roadmap_id") @db.Uuid
  skillId        String?  @map("skill_id") @db.Uuid
  title          String   @db.VarChar(255)
  description    String?  @db.Text
  phase          Int
  milestoneOrder Int      @map("milestone_order")
  status         String   @default("LOCKED") @db.VarChar(30)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roadmap RoadmapState @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  skill   Skill?       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@map("milestones")
}

// ----------------------------------------------------
// 5. Opportunities & Skill Matching
// ----------------------------------------------------

model Opportunity {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalId     String?   @map("external_id") @db.VarChar(255)
  source         String    @default("DIRECT") @db.VarChar(50)
  originalUrl    String?   @map("original_url") @db.Text
  title          String    @db.VarChar(255)
  organization   String    @db.VarChar(255)
  type           String    @default("INTERNSHIP") @db.VarChar(50)
  mode           String    @default("REMOTE") @db.VarChar(50)
  location       String?   @db.VarChar(255)
  deadline       String?   @db.VarChar(100)
  stipend        String?   @db.VarChar(100)
  descriptionRaw String?   @map("description_raw") @db.Text
  eligibilityRaw String?   @map("eligibility_raw") @db.Text
  fingerprint    String?   @unique @db.VarChar(255)
  isActive       Boolean?  @default(true) @map("is_active")
  extractedAt    DateTime? @default(now()) @map("extracted_at") @db.Timestamptz(6)
  lastSeenAt     DateTime? @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  skillTags OpportunitySkillTag[]

  @@map("opportunities")
}

model OpportunitySkillTag {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  opportunityId  String? @map("opportunity_id") @db.Uuid
  skillId        String  @map("skill_id") @db.VarChar(100)
  minProficiency String? @default("BEGINNER") @map("min_proficiency") @db.VarChar(50)
  weight         Float?  @default(1.0)

  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("opportunity_skill_tags")
}
